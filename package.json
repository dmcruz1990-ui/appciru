{
  "name": "plastinex",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:cliente": "npm run dev -w @plastinex/cliente",
    "dev:admin": "npm run dev -w @plastinex/admin",
    "build": "npm run build -w @plastinex/cliente && npm run build -w @plastinex/admin",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
